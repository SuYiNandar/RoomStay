# Supabase → Project Settings → Database → Connection string → URI.
# Use the direct connection, or the session pooler on port 5432.
# Encode special characters in the password. Example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Leave DATABASE_URL empty only in development to use the embedded database.
# Production requires DATABASE_URL, a random JWT_SECRET (32+ characters), and an HTTPS FRONTEND_ORIGIN.
# Production startup never initializes tables or seeds demo accounts. See README.md.
JWT_SECRET=change-me-in-production
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Production: mount a persistent Render disk here; do not use ephemeral storage.
# UPLOAD_DIR=/var/data/roomstay-uploads
